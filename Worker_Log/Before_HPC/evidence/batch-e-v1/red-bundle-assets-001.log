        environment.update(ATOM_MLMM_MODEL_DIR=str(asset_dir), PYTHONPATH=str(ROOT / "src"))
        result = subprocess.run([sys.executable, "-c", probe], cwd=tmp_path, env=environment,
                                capture_output=True, text=True, timeout=30)
